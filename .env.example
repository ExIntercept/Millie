# Copy to .env and fill in. Only LLM_API_KEY is required.

# LLM: any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
# Groq example:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a Groq model that supports tool calling>
# Set to 0 if your provider's streaming tool calls misbehave
LLM_STREAM=1

# Wake word: leave empty to auto-load data/hey_millie.tflite or data/hey_millie.onnx
# (falls back to the built-in "hey_jarvis" model if neither exists)
WAKEWORD_MODEL=
WAKEWORD_THRESHOLD=0.5

# Speech
STT_MODEL=mlx-community/whisper-small-mlx
STT_LANGUAGE=en
# say | kokoro | browser
TTS_BACKEND=say
TTS_VOICE=Samantha
END_SILENCE_MS=900

TIMEZONE=Asia/Kolkata
ASSISTANT_NAME=Millie

# Optional: more accurate song lookup via the Spotify Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
